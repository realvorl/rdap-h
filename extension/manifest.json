{
  "manifest_version": 3,
  "name": "RDAP Human Viewer",
  "version": "1.2.0",
  "description": "Turn RDAP JSON into a readable, standards-aware view. Switch to the original response at any time.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["bundle/rdap.js", "bundle/renderer.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["bundle/viewer.css"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "browser_specific_settings": {"gecko": {"id": "rdap-human-viewer@example.org", "strict_min_version": "109.0"}}
}
