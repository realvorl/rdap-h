{
  "manifest_version": 3,
  "name": "RDAP, but for Humans",
  "version": "1.2.0",
  "minimum_chrome_version": "121",
  "description": "Turn RDAP registration responses into a readable, standards-aware view.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "RDAP, but for Humans", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "background": {"scripts": ["src/background.js"], "service_worker": "src/background.js"},
  "browser_specific_settings": {"gecko": {"id": "rdap-human-viewer@realvorl.github.io", "strict_min_version": "121.0"}},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["bundle/rdap.js", "bundle/renderer.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["bundle/viewer.css", "bundle/theme.css"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
