{
  "manifest_version": 3,
  "name": "RDAP Human Viewer",
  "version": "1.2.0",
  "description": "Turn RDAP registration responses into a readable, standards-aware view.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "RDAP Human Viewer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}},
  "background": {"service_worker": "src/background.js"},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["bundle/rdap.js", "bundle/renderer.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["bundle/viewer.css"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
